<%- include('../header') %>
<!-- ============================================================== -->
        <!-- Page wrapper  -->
        <!-- ============================================================== -->
        <div class="page-wrapper">
            <!-- ============================================================== -->
            <!-- Bread crumb and right sidebar toggle -->
            <!-- ============================================================== -->
            <div class="page-breadcrumb">
                <div class="row">
                    <div class="col-12 d-flex no-block align-items-center">
                        <h4 class="page-title">Add Extra New Category</h4>
                        <div class="ml-auto text-right">
                            <nav aria-label="breadcrumb">
                                <ol class="breadcrumb">
                                    <li class="breadcrumb-item"><a href="/">Home</a></li>
                                    <li class="breadcrumb-item active" aria-current="page">Library</li>
                                </ol>
                            </nav>
                        </div>
                    </div>
                </div>
            </div>
            <!-- ============================================================== -->
            <!-- End Bread crumb and right sidebar toggle -->
            <!-- ============================================================== -->
            <!-- ============================================================== -->
            <!-- Container fluid  -->
            <!-- ============================================================== -->
            <div class="container-fluid">
                <!-- ============================================================== -->
                <!-- Start Page Content -->
                <!-- ============================================================== -->
                <div class="row">
                    <div class="col-md-6">
                        <div class="card">
                            <form class="form-horizontal" action="/extracategory/add-extracategory" method="post">
                                <div class="card-body">
                                    <h4 class="card-title">Sub Category Info</h4>
                                    <div class="form-group row">
                                        <label for="fname" class="col-sm-3 text-right control-label col-form-label">Category Name</label>
                                        <div class="col-sm-9">
                                            <!-- <input type="text" name="category" class="form-control" id="fname" placeholder="Enter Category Name Here"> -->
                                             <select name="category" class="form-control">
                                                <option>Select Category</option>
                                                <% categories.forEach((cat) => { %>
                                                    <option value="<%= cat.id %>"><%= cat.category %></option>
                                                <% }) %>
                                             </select>
                                        </div>
                                    </div>
                                    
                                    <div class="form-group row">
                                        <label for="fname" class="col-sm-3 text-right control-label col-form-label">Sub Category Name</label>
                                        <div class="col-sm-9">
                                            <!-- <input type="text" name="category" class="form-control" id="fname" placeholder="Enter Category Name Here"> -->
                                             <select name="subcategory" class="form-control">
                                                <option>Select Sub Category</option>
                                                <% subcategories.forEach((cat) => { %>
                                                    <option value="<%= cat.id %>"><%= cat.subcategory %></option>
                                                <% }) %>
                                             </select>
                                        </div>
                                    </div>
                                    
                                    <div class="form-group row">
                                        <label for="fname" class="col-sm-3 text-right control-label col-form-label">Extra Category Name</label>
                                        <div class="col-sm-9">
                                            <input type="text" name="extracategory" class="form-control" id="fname" placeholder="Enter Extra Category Name Here">
                                        </div>
                                    </div>
                                    
                                </div>
                                <div class="border-top">
                                    <div class="card-body">
                                        <button type="submit" class="btn btn-primary">Add Extra Category</button>
                                    </div>
                                </div>
                            </form>
                        </div>

                    </div>
                </div>
                <!-- ============================================================== -->
                <!-- End PAge Content -->
                <!-- ============================================================== -->
                <!-- ============================================================== -->
                <!-- Right sidebar -->
                <!-- ============================================================== -->
                <!-- .right-sidebar -->
                <!-- ============================================================== -->
                <!-- End Right sidebar -->
                <!-- ============================================================== -->
            </div>
            <!-- ============================================================== -->
            <!-- End Container fluid  -->
            <!-- ============================================================== -->
<%- include('../footer') %>